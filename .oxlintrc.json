{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  //
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
    // "import",
    // "jsdoc",
    // "node",
    // "promise",
    // "vitest",
    // "vue",
  ],
  //
  "options": {
    "typeAware": true
    // "typeCheck": true,
    // "maxWarnings": 10,
  },
  //
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error"
  },
  //
  "rules": {
    "capitalized-comments": "off",
    "func-style": "off",
    "max-statements": "off",
    "no-console": "off",
    "no-magic-numbers": "off",
    "no-use-before-define": ["error", { "functions": false }],
    "sort-imports": "off",
    "sort-keys": "off",
    //
    "unicorn/no-array-reduce": "off"
  },
  //
  "env": {
    "builtin": true
  }
}
